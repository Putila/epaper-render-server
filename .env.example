# Copy to .env on the server (jail: /app/.env). .env is gitignored — never commit real values.

# Google Calendar "secret iCal URL" — Google Calendar > that calendar's Settings
# > Integrate calendar > "Secret address in iCal format".
CALENDAR_ICAL_URL=

# Telegram bot (home board). Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to post (your family group's id, e.g. -1001234567890).
TELEGRAM_ALLOWED_CHATS=
